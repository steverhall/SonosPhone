[Unit]
Description=Sonos MCP Server - Model Context Protocol server for LLM-based Sonos control
After=network.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/services/MCPServer/run_mcp_server.py --transport http --host 0.0.0.0 --port 8000
Restart=always
RestartSec=10
User=sonosphone
Group=sonosphone

# Environment
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/etc/sonosphone/mcp_server.env

# Working directory
WorkingDirectory=/opt/services/MCPServer

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/log/sonosphone

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=sonosphone-mcp

[Install]
WantedBy=multi-user.target
