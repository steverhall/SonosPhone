# Environment variables for Sonos MCP Server
# This file should be placed at /etc/sonosphone/mcp_server.env

# Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Optional: Network interface to bind to (default: 0.0.0.0)
# MCP_HOST=0.0.0.0

# Optional: Port to listen on (default: 8000)
# MCP_PORT=8000

# Optional: Transport mode (stdio or http, default: http for service)
# MCP_TRANSPORT=http
